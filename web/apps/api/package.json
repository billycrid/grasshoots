{
  "name": "@grasshoots/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "node --import tsx --conditions=development src/infrastructure/database/migrate.ts up",
    "db:rollback": "node --import tsx --conditions=development src/infrastructure/database/migrate.ts down"
  },
  "dependencies": {
    "@grasshoots/contracts": "*",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "@fastify/helmet": "^13.0.0",
    "pg": "^8.16.0",
    "node-pg-migrate": "^8.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  }
}
